{
  "name": "smartping-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --force && vite build --config vite.config.ts",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/locales/locales.test.js .test-dist/utils/charts.test.js .test-dist/utils/concurrency.test.js .test-dist/utils/configValidation.test.js .test-dist/utils/requestCancellation.test.js .test-dist/utils/requestErrors.test.js .test-dist/utils/requestTimeouts.test.js .test-dist/views/mapping.test.js .test-dist/views/topology.test.js .test-dist/views/alerts.test.js .test-dist/views/monitors.test.js .test-dist/stores/config.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,jsx,json,scss,css}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.19.0",
    "china-map-geojson": "1.0.4",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "pinia": "^2.1.7",
    "vue": "^3.5.41",
    "vue-i18n": "11.4.2",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  }
}
